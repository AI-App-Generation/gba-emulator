<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:minHeight="64dp">

    <!-- Quảng cáo thật được gắn vào đây khi load xong -->
    <FrameLayout
        android:id="@+id/frAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Khung xương nhấp nháy trong lúc chờ: hình dạng phải khớp template tương ứng -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerNative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.9"
        app:shimmer_highlight_alpha="0.32"
        app:shimmer_duration="1400">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                android:layout_width="120dp"
                android:layout_height="13dp"
                
                android:background="@drawable/bg_ad_skeleton" />
                <View
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ad_skeleton" />
            </LinearLayout>

            <View
                android:layout_width="84dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_ad_skeleton_pill" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
