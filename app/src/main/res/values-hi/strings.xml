    <string name="store_gate_title">शुरू करने से पहले</string>
    <string name="store_gate_subtitle">गेम स्टोर खोलने से पहले दो ज़रूरी बातें।</string>
    <string name="store_gate_disclaimer_title">सामग्री अस्वीकरण</string>
    <string name="store_gate_disclaimer_body">यह ऐप केवल एक एमुलेटर है — इसमें कोई गेम शामिल नहीं है, न ही यह कोई गेम होस्ट करता है या बेचता है। ऐप में डाउनलोड या इम्पोर्ट की गई फ़ाइलों और उन्हें इस्तेमाल करने के अधिकार की पूरी ज़िम्मेदारी आपकी है। उपयोगकर्ताओं द्वारा इम्पोर्ट की गई सामग्री के लिए हम ज़िम्मेदार नहीं हैं।</string>
    <string name="store_gate_permission_title">तेज़ इम्पोर्ट</string>
    <string name="store_gate_permission_body">ऐप को स्टोरेज पढ़ने की अनुमति दें, ताकि यह आपके डाउनलोड किए गए ROM आर्काइव ढूँढकर सीधे Downloads फ़ोल्डर से इम्पोर्ट कर सके — हर बार फ़ाइलें खोजने की ज़रूरत नहीं।</string>
    <string name="store_gate_settings_hint">Android एक सेटिंग्स पेज खोलेगा। \"सभी फ़ाइलों को मैनेज करने की अनुमति दें\" चालू करें, फिर ऐप पर लौटें।</string>
    <string name="store_gate_grant">सहमत हूँ और अनुमति दें</string>
    <string name="store_gate_footer">आप यह अनुमति कभी भी सिस्टम सेटिंग्स में वापस ले सकते हैं।</string>
